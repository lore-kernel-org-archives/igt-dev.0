+	/* feedback */
+	st_offset = len;
+	st_size = &context->ib_cpu[len++];	/* size */
+	if (context->vcn_ip_version_major == 1)
+		context->ib_cpu[len++] = 0x00000010;	/* FEEDBACK_BUFFER vcn 1 */
+	else
+		context->ib_cpu[len++] = 0x00000015;	/* FEEDBACK_BUFFER vcn 2,3 */
