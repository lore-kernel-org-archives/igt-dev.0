>
> > +#define for_each_sysfs_gt_path(i915__, path__, pathlen__) \
> > +	for (int gt__ = 0; \
> > +	     igt_sysfs_gt_path(i915__, gt__, path__, pathlen__) != NULL; \
> > +	     gt__++)
> > +
