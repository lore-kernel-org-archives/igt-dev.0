+
+	/* check result */
+	check_result(v_context, fb_buf, bs_buf, frame_type, IGT_CODEC_TYPE_HEVC);
+
+	free_resource(&fb_buf);
+	free_resource(&bs_buf);
+	free_resource(&input_buf);
+}
