> > +	/* test_event1_cycles should be close to (test_event1_cycles_xecore* * num_xecores) */
> > +	assert_within_epsilon(first * intel_xe_perf->devinfo.n_eu_sub_slices, pec[2], 0.1);
> > +}
> > +
