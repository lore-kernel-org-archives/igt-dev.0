+	struct amdgpu_mmd_bo dec_buf;
+	int size, len, i, r;
+	unsigned int ip;
+	uint8_t *dec;
+
+	size = 4*1024; /* msg */
+	size += 4*1024; /* fb */
+	size += 4096; /*it_scaling_table*/
