+
+	r = amdgpu_bo_cpu_map(dec_buf.handle, (void **)&dec_buf.ptr);
+	dec = dec_buf.ptr;
+
+	igt_assert_eq(r, 0);
+	memset(dec_buf.ptr, 0, size);
+	memcpy(dec_buf.ptr, p_vcn_dec_decode_msg, vcn_dec_decode_msg_size);
+	memcpy(dec_buf.ptr + vcn_dec_decode_msg_size,
